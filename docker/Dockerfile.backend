FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app

RUN apk add --no-cache maven nodejs npm

# 构建前端
COPY modules/web/package.json modules/web/package-lock.json ./modules/web/
WORKDIR /app/modules/web
RUN npm ci || npm install
COPY modules/web/ ./
RUN npm run build

# 构建后端（Maven 将 dist 复制到 static）
WORKDIR /app/modules/backend-java
COPY modules/backend-java/pom.xml ./
RUN mvn dependency:go-offline -B || true
COPY modules/backend-java/src ./src
RUN mvn clean package -DskipTests -B

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
# 业务日/交易日判定全部基于 LocalDate.now()：容器默认 UTC，北京时间 00:00–08:00
# 会回退到前一天（模拟账户 HISTORICAL_SESSION_REQUIRED、日报 T+N 等）。显式锚定 CST。
RUN apk add --no-cache tzdata && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone
ENV TZ=Asia/Shanghai
COPY --from=build /app/modules/backend-java/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-Duser.timezone=Asia/Shanghai", "-jar", "app.jar"]
