{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/contracts/model_manifest.schema.json",
  "title": "ModelManifest",
  "description": "MP-012/021 minimal model artifact contract. Java validates schema_hash before registry load.",
  "type": "object",
  "required": [
    "data_snapshot_id",
    "feature_set_version",
    "schema_hash",
    "columns",
    "model_version",
    "algorithm"
  ],
  "properties": {
    "data_snapshot_id": { "type": "string", "minLength": 1 },
    "feature_set_version": { "type": "string", "minLength": 1 },
    "schema_hash": { "type": "string", "minLength": 1 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "model_version": { "type": "string", "minLength": 1 },
    "algorithm": { "type": "string", "minLength": 1 },
    "label_version": { "type": "string" },
    "code_version": { "type": "string" },
    "artifact_hash": { "type": "string" },
    "train_window": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "calibration_window": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "test_window": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "metrics_uri": { "type": "string" },
    "demo": {
      "type": "boolean",
      "description": "DEMO artifacts must not be production-eligible"
    }
  },
  "additionalProperties": true
}
